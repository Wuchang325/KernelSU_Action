# ============================================================
# OPPO Reno7 SE 5G
# MediaTek MT6877
# Linux 4.19.191
# ReSukiSU
# ============================================================

KERNEL_SOURCE=https://github.com/oppo-source/android_kernel_oppo_mt6877
KERNEL_SOURCE_BRANCH=oppo/mt6877_t_13.1.0_reno7_se_5g
KERNEL_CONFIG=k6877v1_64_k419_defconfig
KERNEL_IMAGE_NAME=Image.gz
ARCH=arm64

# Keep LOCALVERSION untouched for stock module vermagic compatibility.
KERNEL_NAME=
ADD_LOCALVERSION_TO_FILENAME=false

# Clang / LLVM
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=
USE_LLVM=true

# No GCC toolchain is required for this build.
ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# OPPO MT6877 build environment.
# TARGET_PRODUCT must contain "k419" so OPLUS sensor Makefiles enable
# the Linux 4.19 SCP include path and LINUX_KERNEL_VERSION_419 macro.
CUSTOM_CMDS=CLANG_TRIPLE=aarch64-linux-gnu- CROSS_COMPILE_COMPAT=arm-linux-gnueabi- TARGET_PRODUCT=vnd_oplus6877_k419

EXTRA_CMDS=LD=ld.lld AR=llvm-ar NM=llvm-nm OBJCOPY=llvm-objcopy OBJDUMP=llvm-objdump READELF=llvm-readelf STRIP=llvm-strip KCFLAGS=-Wno-error=strict-prototypes

# ReSukiSU
KSU_VARIANT=resukisu
KSU_REF=main
KSU_HOOK_MODE=manual
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# SUSFS disabled for the initial port.
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# Old-kernel compatibility
ENABLE_PATH_UMOUNT=true

# Optional patches
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# Kernel options
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true

# Stock defconfig already has LTO/CFI disabled.
DISABLE_LTO=false
DISABLE_CC_WERROR=true

# ReSukiSU needs full kallsyms. Keep module signing support but disable FORCE.
EXTRA_DEFCONFIG=CONFIG_KALLSYMS=y CONFIG_KALLSYMS_ALL=y CONFIG_MODULE_SIG_FORCE=n

# Packaging
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
