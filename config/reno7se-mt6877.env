# ============================================================
# OPPO Reno7 SE 5G
# MediaTek MT6877
# Linux 4.19
# ============================================================


# ============================================================
# Kernel source
# ============================================================

KERNEL_SOURCE=https://github.com/oppo-source/android_kernel_oppo_mt6877

KERNEL_SOURCE_BRANCH=oppo/mt6877_t_13.1.0_reno7_se_5g

KERNEL_CONFIG=k6877v1_64_k419_defconfig

KERNEL_IMAGE_NAME=Image.gz

ARCH=arm64


# ============================================================
# Build name
# ============================================================

KERNEL_NAME=Reno7SE-MT6877

ADD_LOCALVERSION_TO_FILENAME=true


# ============================================================
# Clang
#
# Stable choice for old 4.x kernels in KernelSU_Action.
# ============================================================

CLANG_BRANCH=master-kernel-build-2022

CLANG_VERSION=r450784e


USE_CUSTOM_CLANG=false

CUSTOM_CLANG_SOURCE=

CUSTOM_CLANG_BRANCH=


# ============================================================
# LLVM
#
# OPPO's MT6877 Tiramisu config uses:
#
# LLVM=1
# LLVM_IAS=1
#
# ============================================================

USE_LLVM=true


# ============================================================
# GCC
#
# ARM64 compilation uses LLVM.
#
# ARM32 GCC is still required because OPPO's 4.19 tree contains
# 32-bit compat/vdso build logic.
# ============================================================

ENABLE_GCC_ARM64=false

ENABLE_GCC_ARM32=true


USE_CUSTOM_GCC_64=false

CUSTOM_GCC_64_SOURCE=

CUSTOM_GCC_64_BRANCH=

CUSTOM_GCC_64_BIN=aarch64-linux-android-


USE_CUSTOM_GCC_32=false

CUSTOM_GCC_32_SOURCE=

CUSTOM_GCC_32_BRANCH=

CUSTOM_GCC_32_BIN=arm-linux-androideabi-


# ============================================================
# Additional make arguments
#
# CROSS_COMPILE_COMPAT is dynamically set by build-kernel.yml.
# ============================================================

CUSTOM_CMDS=CLANG_TRIPLE=aarch64-linux-gnu-

EXTRA_CMDS=KCFLAGS=-Wno-error=strict-prototypes


# ============================================================
# SukiSU-Ultra
# ============================================================

KSU_VARIANT=sukisu-ultra

KSU_REF=builtin


# ============================================================
# Hook mode
#
# For old non-GKI 4.19 kernels manual hook is preferred.
# ============================================================

KSU_HOOK_MODE=manual


# ============================================================
# Custom manager signature
# ============================================================

KSU_EXPECTED_SIZE=

KSU_EXPECTED_HASH=


# ============================================================
# SUSFS
#
# IMPORTANT:
#
# Disabled for now.
#
# The generic kernel-4.19 SUSFS patch does NOT cleanly apply
# to OPPO's heavily modified MT6877 4.19 tree.
#
# It can be ported separately after the base kernel works.
# ============================================================

ENABLE_SUSFS=false

SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git

SUSFS_BRANCH=auto


# ============================================================
# path_umount
#
# Linux 4.19 predates path_umount().
# ============================================================

ENABLE_PATH_UMOUNT=true


# ============================================================
# Hide stuff
# ============================================================

ENABLE_HIDE_STUFF=false


# ============================================================
# KPM
#
# Disable until base kernel successfully boots.
# ============================================================

ENABLE_KPM=false


# ============================================================
# Kconfig
# ============================================================

ADD_KPROBES_CONFIG=false

ADD_OVERLAYFS_CONFIG=true


# ============================================================
# LTO / warnings
# ============================================================

DISABLE_LTO=true

DISABLE_CC_WERROR=true


# ============================================================
# Extra defconfig
# ============================================================

EXTRA_DEFCONFIG=CONFIG_KALLSYMS=y CONFIG_KALLSYMS_ALL=y


# ============================================================
# AnyKernel3
# ============================================================

USE_CUSTOM_ANYKERNEL3=false

CUSTOM_ANYKERNEL3_SOURCE=

CUSTOM_ANYKERNEL3_BRANCH=


# ============================================================
# DTBO
# ============================================================

NEED_DTBO=false


# ============================================================
# boot.img
#
# First get a successful kernel build.
#
# We will later use the exact stock ColorOS boot.img for
# repacking instead of guessing its boot parameters.
# ============================================================

BUILD_BOOT_IMG=false

SOURCE_BOOT_IMAGE=


# ============================================================
# Runner
# ============================================================

ENABLE_CCACHE=true

REMOVE_UNUSED_PACKAGES=true
