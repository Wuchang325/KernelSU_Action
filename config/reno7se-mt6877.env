# ============================================================
# OPPO Reno7 SE 5G
# MediaTek MT6877
# Linux 4.19.191
# ReSukiSU
# ============================================================


# ============================================================
# Kernel source
# ============================================================

KERNEL_SOURCE=https://github.com/oppo-source/android_kernel_oppo_mt6877

KERNEL_SOURCE_BRANCH=oppo/mt6877_t_13.1.0_reno7_se_5g

KERNEL_CONFIG=k6877v1_64_k419_defconfig

KERNEL_IMAGE_NAME=Image.gz

ARCH=arm64


# ============================================================
# Kernel release
#
# IMPORTANT:
#
# Leave KERNEL_NAME empty.
#
# KernelSU_Action converts KERNEL_NAME into CONFIG_LOCALVERSION.
# Changing CONFIG_LOCALVERSION changes UTS_RELEASE and therefore
# module vermagic.
#
# We want to remain as close as possible to OPPO's stock kernel.
# ============================================================

KERNEL_NAME=

ADD_LOCALVERSION_TO_FILENAME=false


# ============================================================
# Clang
#
# Verified old-kernel toolchain in KernelSU_Action.
#
# OPPO originally used r433403b.
# We start with r450784e because it is already supported directly
# by KernelSU_Action.
#
# If an MTK compiler incompatibility appears later, switch to
# OPPO's original r433403b.
# ============================================================

CLANG_BRANCH=master-kernel-build-2022

CLANG_VERSION=r450784e


USE_CUSTOM_CLANG=false

CUSTOM_CLANG_SOURCE=

CUSTOM_CLANG_BRANCH=


# ============================================================
# LLVM
#
# OPPO MT6877 original build configuration uses:
#
# LLVM=1
# LLVM_IAS=1
# CC=clang
# LD=ld.lld
# ============================================================

USE_LLVM=true


# ============================================================
# GCC
#
# GCC is NOT needed here.
#
# arch/arm64/kernel/vdso32/Makefile uses clang when:
#
# CONFIG_CC_IS_CLANG=y
#
# CROSS_COMPILE_COMPAT is only used for the ARM32 target name:
#
# clang --target=arm-linux-gnueabi
#
# LLVM=1 also selects the LLVM linker for vdso32.
# ============================================================

ENABLE_GCC_ARM64=false

ENABLE_GCC_ARM32=false


USE_CUSTOM_GCC_64=false

CUSTOM_GCC_64_SOURCE=

CUSTOM_GCC_64_BRANCH=

CUSTOM_GCC_64_BIN=aarch64-linux-android-


USE_CUSTOM_GCC_32=false

CUSTOM_GCC_32_SOURCE=

CUSTOM_GCC_32_BRANCH=

CUSTOM_GCC_32_BIN=arm-linux-androideabi-


# ============================================================
# OPPO MT6877 compiler configuration
# ============================================================

CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu- CROSS_COMPILE_COMPAT=arm-linux-gnueabi-

EXTRA_CMDS:LD=ld.lld AR=llvm-ar NM=llvm-nm OBJCOPY=llvm-objcopy OBJDUMP=llvm-objdump READELF=llvm-readelf STRIP=llvm-strip KCFLAGS=-Wno-error=strict-prototypes


# ============================================================
# ReSukiSU
# ============================================================

KSU_VARIANT=resukisu

KSU_REF=main


# ============================================================
# Hook mode
#
# Reno7 SE 4.19 uses explicit manual syscall hooks.
#
# Our OPPO-specific integration script installs the hook code.
#
# KSU_HOOK_MODE=manual remains enabled so KernelSU_Action adds:
#
# CONFIG_KSU_MANUAL_HOOK=y
# CONFIG_DEBUG_KERNEL=y
# CONFIG_KALLSYMS=y
# CONFIG_KALLSYMS_ALL=y
# ============================================================

KSU_HOOK_MODE=manual


# ============================================================
# Custom manager signature
# ============================================================

KSU_EXPECTED_SIZE=

KSU_EXPECTED_HASH=


# ============================================================
# SUSFS
#
# OFF.
#
# Generic SUSFS kernel-4.19 patch does not apply cleanly to the
# OPPO MT6877 4.19 tree.
# ============================================================

ENABLE_SUSFS=false

SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git

SUSFS_BRANCH=auto


# ============================================================
# path_umount
#
# Required for this old 4.19 kernel.
# ============================================================

ENABLE_PATH_UMOUNT=true


# ============================================================
# Optional patches
# ============================================================

ENABLE_HIDE_STUFF=false

ENABLE_KPM=false


# ============================================================
# Kconfig
# ============================================================

ADD_KPROBES_CONFIG=false

ADD_OVERLAYFS_CONFIG=true


# ============================================================
# LTO / CFI
#
# Stock Reno7 SE defconfig already has:
#
# #CONFIG_LTO_CLANG is not set
# #CONFIG_CFI_CLANG is not set
#
# Preserve the original state.
# ============================================================

DISABLE_LTO=false


# ============================================================
# Compiler warning policy
# ============================================================

DISABLE_CC_WERROR=true


# ============================================================
# Extra kernel configuration
#
# CONFIG_MODULE_SIG_FORCE:
#
# OPPO enables FORCE in the stock defconfig.
#
# A locally-built kernel does not possess OPPO's private signing
# key. Keep module signature support, but do not force signatures
# so stock/vendor modules are not automatically rejected merely
# for lacking a locally trusted key.
#
# Do NOT change LOCALVERSION.
# ============================================================

EXTRA_DEFCONFIG=CONFIG_KALLSYMS=y CONFIG_KALLSYMS_ALL=y CONFIG_MODULE_SIG_FORCE=n


# ============================================================
# AnyKernel3
#
# Generated only as an additional artifact.
#
# Do NOT use it as our preferred flashing method yet.
# ============================================================

USE_CUSTOM_ANYKERNEL3=false

CUSTOM_ANYKERNEL3_SOURCE=

CUSTOM_ANYKERNEL3_BRANCH=


# ============================================================
# DTBO
# ============================================================

NEED_DTBO=false


# ============================================================
# boot.img
#
# Keep disabled until the first Image.gz succeeds.
#
# After that we will use your exact stock boot.img and only
# replace its kernel.
# ============================================================

BUILD_BOOT_IMG=false

SOURCE_BOOT_IMAGE=


# ============================================================
# Runner
# ============================================================

ENABLE_CCACHE=true

REMOVE_UNUSED_PACKAGES=true
