# ============================================================
# OPPO Reno7 SE 5G
# MediaTek MT6877
# Linux 4.19
# ============================================================


# ============================================================
# Kernel
# ============================================================

KERNEL_SOURCE=https://github.com/oppo-source/android_kernel_oppo_mt6877

KERNEL_SOURCE_BRANCH=oppo/mt6877_t_13.1.0_reno7_se_5g

KERNEL_CONFIG=k6877v1_64_k419_defconfig

KERNEL_IMAGE_NAME=Image.gz

ARCH=arm64


# ============================================================
# Name
# ============================================================

KERNEL_NAME=Reno7SE-MT6877

ADD_LOCALVERSION_TO_FILENAME=true


# ============================================================
# Clang
#
# KernelSU_Action verified old-kernel toolchain.
# ============================================================

CLANG_BRANCH=master-kernel-build-2022

CLANG_VERSION=r450784e

USE_CUSTOM_CLANG=false

CUSTOM_CLANG_SOURCE=

CUSTOM_CLANG_BRANCH=


# ============================================================
# LLVM
#
# OPPO Tiramisu build configuration uses:
#
# LLVM=1
# LLVM_IAS=1
#
# ============================================================

USE_LLVM=true


# ============================================================
# GCC
#
# arm64 is compiled through LLVM.
#
# ARM32 GCC is still downloaded because OPPO's 4.19 tree
# can use CROSS_COMPILE_COMPAT for vdso32 compatibility.
#
# ============================================================

ENABLE_GCC_ARM64=false

ENABLE_GCC_ARM32=true


USE_CUSTOM_GCC_64=false

CUSTOM_GCC_64_SOURCE=

CUSTOM_GCC_64_BRANCH=

CUSTOM_GCC_64_BIN=aarch64-linux-android-


USE_CUSTOM_GCC_32=false

CUSTOM_GCC_32_SOURCE=

CUSTOM_GCC_32_BRANCH=

CUSTOM_GCC_32_BIN=arm-linux-androideabi-


# ============================================================
# Build flags
#
# CROSS_COMPILE_COMPAT is added dynamically by workflow
# because it needs the absolute GCC32 path.
# ============================================================

CUSTOM_CMDS=CLANG_TRIPLE=aarch64-linux-gnu-

EXTRA_CMDS=KCFLAGS=-Wno-error=strict-prototypes


# ============================================================
# SukiSU-Ultra
# ============================================================

KSU_VARIANT=sukisu-ultra

KSU_REF=builtin


# ============================================================
# Hooks
#
# Old non-GKI 4.19 kernel:
#
# manual is preferred over kprobes.
# ============================================================

KSU_HOOK_MODE=manual


# ============================================================
# Manager signature
# ============================================================

KSU_EXPECTED_SIZE=

KSU_EXPECTED_HASH=


# ============================================================
# SUSFS
# ============================================================

ENABLE_SUSFS=true

SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git

SUSFS_BRANCH=auto


# ============================================================
# path_umount
#
# Linux 4.19 does not provide the modern path_umount API.
# ============================================================

ENABLE_PATH_UMOUNT=true


# ============================================================
# Fingerprint hiding
# ============================================================

ENABLE_HIDE_STUFF=false


# ============================================================
# KPM
#
# Keep disabled for the first bootable build.
#
# Enable after confirming:
#
# - kernel builds
# - device boots
# - SukiSU works
# - SUSFS works
#
# ============================================================

ENABLE_KPM=false


# ============================================================
# Kernel config
# ============================================================

ADD_KPROBES_CONFIG=false

ADD_OVERLAYFS_CONFIG=true


# ============================================================
# LTO / compiler warnings
# ============================================================

DISABLE_LTO=true

DISABLE_CC_WERROR=true


# ============================================================
# Extra Kconfig
# ============================================================

EXTRA_DEFCONFIG=CONFIG_KALLSYMS=y CONFIG_KALLSYMS_ALL=y


# ============================================================
# AnyKernel3
# ============================================================

USE_CUSTOM_ANYKERNEL3=false

CUSTOM_ANYKERNEL3_SOURCE=

CUSTOM_ANYKERNEL3_BRANCH=


# ============================================================
# DTBO
# ============================================================

NEED_DTBO=false


# ============================================================
# boot.img
#
# First build:
#
# only generate Image.gz + AnyKernel3.
#
# We can enable stock boot.img repacking later.
# ============================================================

BUILD_BOOT_IMG=false

SOURCE_BOOT_IMAGE=


# ============================================================
# GitHub Runner
# ============================================================

ENABLE_CCACHE=true

REMOVE_UNUSED_PACKAGES=true
