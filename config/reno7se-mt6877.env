# ============================================================
# OPPO Reno7 SE 5G / MT6877 / Linux 4.19
# ============================================================

# 改成你 fork 的 android_kernel_oppo_mt6877
KERNEL_SOURCE=<你的 android_kernel_oppo_mt6877 fork HTTPS clone 地址>
KERNEL_SOURCE_BRANCH=oppo/mt6877_t_13.1.0_reno7_se_5g

KERNEL_CONFIG=k6877v1_64_k419_defconfig
KERNEL_IMAGE_NAME=Image.gz

ARCH=arm64

KERNEL_NAME=Reno7SE-MT6877
ADD_LOCALVERSION_TO_FILENAME=true


# ============================================================
# Toolchain
# ============================================================

# KernelSU_Action 当前针对 4.9~4.19 推荐的稳定组合
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e

USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

# 这棵 OPPO Tiramisu 内核本身就是 LLVM 构建配置
USE_LLVM=true

# LLVM + LLVM_IAS，不再依赖 Android GCC 4.9 做实际汇编
ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false

USE_CUSTOM_GCC_64=false
USE_CUSTOM_GCC_32=false

# OPPO arm64 4.19 的 compat VDSO 使用 CROSS_COMPILE_COMPAT
CUSTOM_CMDS=CROSS_COMPILE_COMPAT=arm-linux-gnueabi-

# 某些 MTK 旧代码在新 Clang 下会触发 strict-prototypes
EXTRA_CMDS=KCFLAGS=-Wno-error=strict-prototypes


# ============================================================
# SukiSU-Ultra
# ============================================================

KSU_VARIANT=sukisu-ultra

# 4.19 Non-GKI 使用源码内置分支
KSU_REF=builtin

# 明确使用 manual，而不是让旧厂商内核依赖 kprobes
KSU_HOOK_MODE=manual

KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=


# ============================================================
# SUSFS
# ============================================================

ENABLE_SUSFS=true
SUSFS_BRANCH=auto


# ============================================================
# Legacy kernel
# ============================================================

# Linux 4.19 没有原生 path_umount()
ENABLE_PATH_UMOUNT=true

ENABLE_HIDE_STUFF=false


# ============================================================
# KPM
# ============================================================

# 第一阶段建议关闭。
# 先验证 SukiSU + SUSFS 内核能正常编译和启动。
ENABLE_KPM=false


# ============================================================
# Kernel config
# ============================================================

# manual hook 不要求额外开启 kprobes
ADD_KPROBES_CONFIG=false

ADD_OVERLAYFS_CONFIG=true

# 降低旧 MTK 内核编译问题
DISABLE_LTO=true
DISABLE_CC_WERROR=true

# 显式保证完整 kallsyms
EXTRA_DEFCONFIG=CONFIG_KALLSYMS=y CONFIG_KALLSYMS_ALL=y


# ============================================================
# Packaging
# ============================================================

NEED_DTBO=false

# 第一轮先生成 Image.gz + AnyKernel3
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=


# ============================================================
# Runner
# ============================================================

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
