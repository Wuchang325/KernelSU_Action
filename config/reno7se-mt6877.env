# ============================================================
# OPPO Reno7 SE 5G
# MediaTek MT6877
# Linux 4.19.191
# ReSukiSU
# ============================================================


# ============================================================
# Kernel source
# ============================================================

KERNEL_SOURCE=https://github.com/oppo-source/android_kernel_oppo_mt6877

KERNEL_SOURCE_BRANCH=oppo/mt6877_t_13.1.0_reno7_se_5g

KERNEL_CONFIG=k6877v1_64_k419_defconfig

KERNEL_IMAGE_NAME=Image.gz

ARCH=arm64


# ============================================================
# Kernel release
#
# IMPORTANT:
#
# Do NOT set KERNEL_NAME here.
#
# KernelSU_Action will convert KERNEL_NAME into CONFIG_LOCALVERSION.
# That changes UTS_RELEASE / module vermagic.
#
# We want to preserve the original OPPO kernel release as closely
# as possible so stock vendor modules have a chance to load.
# ============================================================

KERNEL_NAME=

ADD_LOCALVERSION_TO_FILENAME=false


# ============================================================
# Clang
#
# r450784e is currently the verified KernelSU_Action 4.19
# toolchain and already successfully reached your defconfig stage.
#
# If we later hit a compiler-specific MTK issue, the fallback is
# OPPO's original r433403b.
# ============================================================

CLANG_BRANCH=master-kernel-build-2022

CLANG_VERSION=r450784e

USE_CUSTOM_CLANG=false

CUSTOM_CLANG_SOURCE=

CUSTOM_CLANG_BRANCH=


# ============================================================
# LLVM
#
# OPPO's own MT6877 build configuration uses:
#
# LLVM=1
# LLVM_IAS=1
# CC=clang
# LD=ld.lld
#
# ============================================================

USE_LLVM=true


# ============================================================
# GCC
#
# NO GCC32.
#
# The OPPO 4.19 vdso32 Makefile uses clang when
# CONFIG_CC_IS_CLANG=y.
#
# CROSS_COMPILE_COMPAT is only used to form:
#
# clang --target=arm-linux-gnueabi
#
# LLVM=1 also causes LD_COMPAT to use LLVM's linker.
# ============================================================

ENABLE_GCC_ARM64=false

ENABLE_GCC_ARM32=false


USE_CUSTOM_GCC_64=false

CUSTOM_GCC_64_SOURCE=

CUSTOM_GCC_64_BRANCH=

CUSTOM_GCC_64_BIN=aarch64-linux-android-


USE_CUSTOM_GCC_32=false

CUSTOM_GCC_32_SOURCE=

CUSTOM_GCC_32_BRANCH=

CUSTOM_GCC_32_BIN=arm-linux-androideabi-


# ============================================================
# OPPO MT6877 compiler configuration
# ============================================================

CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu- CROSS_COMPILE_COMPAT=arm-linux-gnueabi-

EXTRA_CMDS:LD=ld.lld AR=llvm-ar NM=llvm-nm OBJCOPY=llvm-objcopy OBJDUMP=llvm-objdump READELF=llvm-readelf STRIP=llvm-strip KCFLAGS=-Wno-error=strict-prototypes


# ============================================================
# ReSukiSU
# ============================================================

KSU_VARIANT=resukisu

KSU_REF=main


# ============================================================
# ReSukiSU hook
#
# We use our own OPPO MT6877-specific 4.19 hook patch.
#
# build.sh still needs this set to manual so it enables:
#
# CONFIG_KSU_MANUAL_HOOK=y
# CONFIG_DEBUG_KERNEL=y
# CONFIG_KALLSYMS=y
# CONFIG_KALLSYMS_ALL=y
#
# ============================================================

KSU_HOOK_MODE=manual


# ============================================================
# Manager signature
# ============================================================

KSU_EXPECTED_SIZE=

KSU_EXPECTED_HASH=


# ============================================================
# SUSFS
#
# Disabled.
#
# Generic SUSFS kernel-4.19 patch does not cleanly apply to
# this OPPO MT6877 kernel.
# ============================================================

ENABLE_SUSFS=false

SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git

SUSFS_BRANCH=auto


# ============================================================
# path_umount
# ============================================================

ENABLE_PATH_UMOUNT=true


# ============================================================
# Other patches
# ============================================================

ENABLE_HIDE_STUFF=false

ENABLE_KPM=false


# ============================================================
# Kernel options
# ============================================================

ADD_KPROBES_CONFIG=false

ADD_OVERLAYFS_CONFIG=true


# ============================================================
# LTO
#
# Do NOT force-disable it here.
#
# The stock Reno7 SE defconfig already contains:
#
# #CONFIG_LTO_CLANG is not set
# #CONFIG_CFI_CLANG is not set
#
# Therefore preserve the stock configuration.
# ============================================================

DISABLE_LTO=false


# ============================================================
# Werror
# ============================================================

DISABLE_CC_WERROR=true


# ============================================================
# Extra config
#
# MODULE_SIG_FORCE:
#
# Stock OPPO enables CONFIG_MODULE_SIG_FORCE=y.
#
# A locally built kernel does NOT have OPPO's original private
# module signing key. Enforcing signatures would risk rejecting
# stock vendor modules.
#
# Keep CONFIG_MODULE_SIG itself, but make enforcement permissive.
# ============================================================

EXTRA_DEFCONFIG=CONFIG_KALLSYMS=y CONFIG_KALLSYMS_ALL=y CONFIG_MODULE_SIG_FORCE=n


# ============================================================
# AnyKernel3
# ============================================================

USE_CUSTOM_ANYKERNEL3=false

CUSTOM_ANYKERNEL3_SOURCE=

CUSTOM_ANYKERNEL3_BRANCH=


# ============================================================
# DTBO
# ============================================================

NEED_DTBO=false


# ============================================================
# boot.img
#
# Do NOT auto-build boot.img yet.
#
# First get a known-good Image.gz.
# Then repack the exact boot.img from your current ROM.
# ============================================================

BUILD_BOOT_IMG=false

SOURCE_BOOT_IMAGE=


# ============================================================
# Runner
# ============================================================

ENABLE_CCACHE=true

REMOVE_UNUSED_PACKAGES=true
